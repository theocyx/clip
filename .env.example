# --- Accès à l'interface ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi
MFA=true                  # code Google Authenticator en plus du mot de passe
SESSION_DAYS=30
# Adresse publique du serveur (https obligatoire pour TikTok)
PUBLIC_URL=https://clip.mondomaine.fr
# E-mail de contact affiché sur /privacy et /terms (demandé par Google et TikTok)
CONTACT_EMAIL=
DOMAIN=clip.mondomaine.fr

# --- Transcription (tiny/base = rapide, small = bon compromis, medium = précis mais lent) ---
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr
# WHISPER_PROMPT=GTA 6, Vice City, Lucia, Jason…   # noms propres à bien écrire dans les sous-titres

# --- IA locale (titres + choix des moments). OLLAMA_URL vide pour désactiver ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Chat Twitch des lives : ses rafales (MDR, KEKW, !!!) aident à trouver les moments forts ---
CHAT_SIGNAL=true
CHAT_WEIGHT=0.5

# --- Clips ---
CLIPS_PER_VIDEO=3          # clips par heure de vidéo
CLIP_TARGET=62             # durée visée (s) : les TikTok GTA 6 de la chaîne qui marchent font 60 à 68 s
CLIP_MIN=35
CLIP_MAX=75                # durée max, prolongée si la phrase n'est pas finie
ALLOW_PARTS=false          # true = clips longs coupés en "Partie 1/2" (la partie 2 n'est presque jamais vue)
PART_MAX=90
HASHTAGS=#shorts #clip #fr
HOOK_TITLE=true           # accroche courte en haut de la vidéo
HOOK_SECONDS=0            # durée d'affichage de l'accroche (0 = tout le clip)
HOOK_EMOJIS=true          # emoji en lien avec le contenu à la fin de l'accroche
TEASER=false              # ouverture choc (meilleur passage en premier) : non, un seul plan continu
TEASER_SECONDS=2.5
LAYOUT=auto               # auto : facecam en haut + jeu en bas si une facecam est détectée ; classic ; split
SPLIT_CAM_HEIGHT=614      # hauteur de la facecam (px sur 1920, 32 %)

# --- Vidéo : auto (GPU intégré si /dev/dri est accessible, sinon CPU), libx264 (CPU) ou h264_vaapi (GPU) ---
VIDEO_CODEC=auto
# VAAPI_DEVICE=/dev/dri/renderD128

# --- Publication ---
AUTO_PUBLISH=true
MIN_MINUTES_BETWEEN_POSTS=90
MAX_POSTS_PER_DAY=100       # YouTube : 100 envois/jour (console Google), 0 = pas de limite ; si YouTube refuse (quota atteint), reprise le lendemain
# Qualité plutôt que quantité : publier en rafale fait chuter les vues de chaque Short
POST_GAP_FLOOR=40           # écart minimum imposé (min), même si l'interface dit moins ; 0 = non
DAILY_CAP=10                # Shorts max par jour, quoi qu'il arrive (les meilleurs d'abord) ; 0 = aucun
SPREAD_POSTS=true           # répartit les envois du jour sur les heures qui restent
QUIET_HOURS=1-8             # aucun envoi la nuit (même en mode GTA 6) ; vide = aucune
PUBLISH_MIN_LLM=7           # clips notés sous 7/10 par l'IA : pas publiés automatiquement (relevé si les stats le montrent)
PUBLISH_TOP_PCT=20          # seuls les 20 % meilleurs clips de la semaine partent tout seuls ; 0 = pas de seuil
CLIP_MIN_LLM=6              # vidéo source pas bonne : moments notés sous 6/10 pas montés, 0 clip possible
POLISH=true                 # avant l'envoi : 2e avis de l'IA avec ce qu'elle a appris, titre et question revus
TOPIC_ONLY=true             # seuls les clips GTA partent automatiquement
QUEUE_MAX_HOURS=36          # clip en attente depuis plus longtemps : retiré (plus d'actualité)
PUBLISH_HOURS=12-14,18-22   # heures où les clips sont publiés (heure de Paris), vide = à toute heure
TIMEZONE=Europe/Paris        # fuseau des heures de publication et des dates affichées (les logs sont à l'heure de Paris via le Dockerfile)
CREDIT_STREAMER=true        # nom + lien de la chaîne du streamer dans la description
TREND_HASHTAGS=true         # #GTA6, #GTARP, serveur RP… ajoutés selon le titre et ce qui est dit
# RP_SERVERS=Lunar City=#LunarCity; Mon Serveur=#MonServeur    # serveurs RP en plus de ceux connus
# TREND_RULES=braquage|casse=#Braquage                         # règles mot(s)=hashtags en plus
MAX_HASHTAGS=10
TITLE_HASHTAGS=2          # hashtags ajoutés en fin de titre YouTube
TIKTOK_MAX_HASHTAGS=2     # légende courte et orale + #gta6 #gta

# --- Anti-doublons : une seule fois la même scène RP vécue par plusieurs streamers ---
DEDUPE=true
DEDUPE_HOURS=48
DEDUPE_SIMILARITY=0.3

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MODE=direct          # direct ou draft (brouillon dans l'appli)
TIKTOK_PRIVACY=SELF_ONLY    # PUBLIC_TO_EVERYONE une fois l'app approuvée par TikTok
TIKTOK_STATS=false          # true après avoir ajouté le scope video.list à l'app (lecture des vues)

# --- Apprentissage : stats des clips publiés → ajustement automatique du montage ---
LEARNING=true
STATS_INTERVAL_HOURS=3
REVIEW_AGE_HOURS=24          # chaque Short est analysé (vues, rétention, likes, commentaires) à cet âge
LEARN_MIN_CLIPS=10          # clips mesurés avant le premier ajustement

# --- Mode « GTA 6 day one » (activable aussi depuis le tableau de bord) ---
GTA6_MODE=auto              # auto = actif de la veille au soir du 19/11 pendant 3 jours ; on ; off
GTA6_DATE=2026-11-19
GTA6_DAYS=3
GTA6_MAX_RECORDINGS=3       # lives GTA 6 enregistrés en même temps (les plus regardés d'abord), les autres en file
GTA6_FRESH_HOURS=3          # file d'envoi : le score d'un clip compte 2x moins toutes les 3 h pendant le mode
GTA6_CHUNK_MINUTES=20       # live découpé en morceaux de 20 min : premiers clips pendant que le streamer joue
GTA6_POLL_INTERVAL=90       # vérification des lives toutes les 90 s
GTA6_MIN_MINUTES_BETWEEN_POSTS=30
GTA6_PUBLISH_ANYTIME=true   # publie sans attendre les heures de PUBLISH_HOURS
# GTA6_PRIORITY=squeezie,kamet0   # streamers à enregistrer avant les autres

# Santé du serveur (alertes par notification)
HEALTH=true
HEALTH_DISK_PCT=90          # alerte si disque plus plein que ça…
HEALTH_DISK_MIN_GB=5        # … ou moins de 5 Go libres
HEALTH_TEMP_MAX=90          # °C
HEALTH_RAM_PCT=92

# Découverte automatique des streamers FR sur GTA
DISCOVER=true
DISCOVER_MIN_VIEWERS=150
DISCOVER_MAX_SOURCES=10     # plafond de chaînes ajoutées automatiquement
DISCOVER_PER_RUN=2
DISCOVER_EXPIRE_DAYS=7      # retirées si plus vues en live GTA depuis 7 jours

# --- Vidéos d'actu générées automatiquement (voir README) ---
NEWS=true
NEWS_PER_DAY=3
NEWS_HOURS=7-22
NEWS_TOPIC=actualité France et monde
# NEWS_FEEDS=https://www.francetvinfo.fr/titres.rss,https://www.lemonde.fr/rss/une.xml
# NEWS_KEYWORDS=gta,rockstar  # seulement ces sujets (vide = tous)
NEWS_MIN_SCORE=6
NEWS_TARGET_SECONDS=70      # durée visée d'une actu (s)
NEWS_MIN_SECONDS=60         # plus court : script rallongé par l'IA, sinon sujet écarté
STORIES=true                # histoires vraies envoûtantes (Room 641A, col Dyatlov…), faits tirés de Wikipédia
STORY_PER_DAY=1
STORY_TARGET_SECONDS=90
STORY_MIN_SECONDS=75
# STORY_TOPICS=Room 641A,Opération Mincemeat   # tes sujets (aussi : data/stories.txt, un par ligne)
NEWS_AI_IMAGES=pollinations # images IA gratuites sans clé ; huggingface (avec HF_TOKEN) ; off
# HF_TOKEN=
NEWS_CTA=true               # rappel animé LIKE · COMMENTE · ABONNE-TOI
NEWS_BRAND=ACTU EN BREF     # ton nom de marque dans le bandeau (jamais celui d'un autre compte)
NEWS_PUBLISH=true           # false = rangées dans Clips sans publication auto
NEWS_TTS=edge               # edge = voix neuronale Microsoft gratuite (naturelle) ; piper = 100 % locale
NEWS_EDGE_VOICE=fr-FR-HenriNeural
STORY_EDGE_VOICE=fr-FR-RemyMultilingualNeural
NEWS_WRITER_MODEL=qwen2.5:7b    # modèle local plus fort pour écrire les récits (téléchargé une fois, ~5 Go)
NEWS_VOICE=fr_FR-tom-medium # ou fr_FR-siwis-medium (voix féminine)
NEWS_VOICE_SPEED=1.12
PEXELS_API_KEY=             # clé gratuite pexels.com/api : vidéos libres de droits (recommandé)
PIXABAY_API_KEY=            # clé gratuite pixabay.com/api/docs (photos + vidéos), alternative à Pexels
# NEWS_OPENVERSE=true       # images libres via Openverse, sans clé

# --- Notifications (clip publié, erreur) : Discord et/ou Telegram, vide = désactivé ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_PUBLISHED=true
NOTIFY_ERRORS=true

# --- Sauvegarde de la base (data/backups, 1 par jour) et ménage du disque ---
BACKUP_KEEP=7               # sauvegardes gardées
SOURCE_KEEP_DAYS=3          # vidéos sources supprimées après N jours
CLIP_KEEP_DAYS=14           # fichiers des clips déjà publiés supprimés après N jours (0 = jamais)

# --- Croissance de la chaîne (page Stats) ---
# GROWTH_MIX=true            # le format qui fait le plus de vues passe devant et est produit plus souvent
# MIX_DAYS=7
# MIX_TEST_DAYS=3            # format qui ne marche pas : un essai tous les N jours seulement
# RESERVE=true               # clips GTA juste sous le seuil gardés en réserve (partent si la file serait vide)
# SOURCE_PRIORITY=true       # streamers dont les clips marchent : enregistrés et traités en premier
# SUBSCRIBE_LINK=true        # lien « abonne-toi » en un clic dans les descriptions YouTube
# COMPIL=true                # compilation longue des meilleurs Shorts chaque semaine (heures de visionnage)
# COMPIL_DAY=6               # 0 = lundi … 6 = dimanche
# COMPIL_HOUR=18
# COMPIL_KINDS=clip          # clip, story, news
# COMPIL_MAX=15
# FIRST_COMMENT=true         # la chaîne pose la question du clip en 1er commentaire (reconnecter YouTube une fois)
# SHARE_LINE=true            # « 📤 Envoie-le à un pote… » dans les descriptions YouTube
