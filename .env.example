# --- Accès à l'interface ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi
MFA=true                  # code Google Authenticator en plus du mot de passe
SESSION_DAYS=30
# Adresse publique du serveur (https obligatoire pour TikTok)
PUBLIC_URL=https://clip.mondomaine.fr
DOMAIN=clip.mondomaine.fr

# --- Transcription (tiny/base = rapide, small = bon compromis, medium = précis mais lent) ---
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr

# --- IA locale (titres + choix des moments). OLLAMA_URL vide pour désactiver ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Clips ---
CLIPS_PER_VIDEO=3          # clips par heure de vidéo
CLIP_TARGET=60             # durée visée (s)
CLIP_MAX=180               # durée max, prolongée si la phrase n'est pas finie
PART_MAX=90                # au-delà, découpage en "Partie 1/2"
HASHTAGS=#shorts #clip #fr
HOOK_TITLE=true           # accroche courte en haut de la vidéo
HOOK_SECONDS=0            # durée d'affichage de l'accroche (0 = tout le clip)
HOOK_EMOJIS=true          # emojis en lien avec le contenu dans l'accroche
LAYOUT=auto               # auto : facecam en haut + jeu en bas si une facecam est détectée ; classic ; split
SPLIT_CAM_HEIGHT=640      # hauteur de la facecam (px sur 1920)

# --- Vidéo : libx264 (CPU) ou h264_vaapi (GPU intégré, voir docker-compose.yml) ---
VIDEO_CODEC=libx264
# VAAPI_DEVICE=/dev/dri/renderD128

# --- Publication ---
AUTO_PUBLISH=true
MIN_MINUTES_BETWEEN_POSTS=90
MAX_POSTS_PER_DAY=6
PUBLISH_HOURS=12-14,18-22   # heures où les clips sont publiés (heure de Paris), vide = à toute heure
TIMEZONE=Europe/Paris
CREDIT_STREAMER=true        # nom + lien de la chaîne du streamer dans la description
TREND_HASHTAGS=true         # #GTA6, #GTARP, serveur RP… ajoutés selon le titre et ce qui est dit
# RP_SERVERS=Lunar City=#LunarCity; Mon Serveur=#MonServeur    # serveurs RP en plus de ceux connus
# TREND_RULES=braquage|casse=#Braquage                         # règles mot(s)=hashtags en plus
MAX_HASHTAGS=10

# --- Anti-doublons : une seule fois la même scène RP vécue par plusieurs streamers ---
DEDUPE=true
DEDUPE_HOURS=48
DEDUPE_SIMILARITY=0.3

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MODE=direct          # direct ou draft (brouillon dans l'appli)
TIKTOK_PRIVACY=SELF_ONLY    # PUBLIC_TO_EVERYONE une fois l'app approuvée par TikTok
TIKTOK_STATS=false          # true après avoir ajouté le scope video.list à l'app (lecture des vues)

# --- Apprentissage : stats des clips publiés → ajustement automatique du montage ---
LEARNING=true
STATS_INTERVAL_HOURS=6
LEARN_MIN_CLIPS=10          # clips mesurés avant le premier ajustement

# --- Mode « GTA 6 day one » (activable aussi depuis le tableau de bord) ---
GTA6_MODE=auto              # auto = actif de la veille au soir du 19/11 pendant 3 jours ; on ; off
GTA6_DATE=2026-11-19
GTA6_DAYS=3
GTA6_MAX_RECORDINGS=3       # lives GTA 6 enregistrés en même temps (les plus regardés d'abord), les autres en file
GTA6_CHUNK_MINUTES=20       # live découpé en morceaux de 20 min : premiers clips pendant que le streamer joue
GTA6_POLL_INTERVAL=90       # vérification des lives toutes les 90 s
GTA6_MIN_MINUTES_BETWEEN_POSTS=30
GTA6_PUBLISH_ANYTIME=true   # publie sans attendre les heures de PUBLISH_HOURS
# GTA6_PRIORITY=squeezie,kamet0   # streamers à enregistrer avant les autres

# --- Notifications (clip publié, erreur) : Discord et/ou Telegram, vide = désactivé ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_PUBLISHED=true
NOTIFY_ERRORS=true

# --- Sauvegarde de la base (data/backups, 1 par jour) et ménage du disque ---
BACKUP_KEEP=7               # sauvegardes gardées
SOURCE_KEEP_DAYS=3          # vidéos sources supprimées après N jours
CLIP_KEEP_DAYS=14           # fichiers des clips déjà publiés supprimés après N jours (0 = jamais)
